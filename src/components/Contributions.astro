---
// GitHub-style contribution heatmap, rendered as static SVG at build time.
interface Day {
  date: string;
  count: number;
  level: number;
}
interface Props {
  weeks: Day[][];
  total: number;
}
const { weeks, total } = Astro.props;

const cell = 11;
const gap = 3;
const width = weeks.length * (cell + gap);
const height = 7 * (cell + gap);
const fills = [
  'fill-slate-200 dark:fill-white/[0.06]',
  'fill-teal-200 dark:fill-teal-900',
  'fill-teal-400 dark:fill-teal-700',
  'fill-teal-600 dark:fill-teal-500',
  'fill-teal-800 dark:fill-teal-300',
];
const months = weeks
  .map((w, i) => ({ i, d: new Date(w[0].date) }))
  .filter(({ d }, idx, arr) => idx === 0 || d.getMonth() !== arr[idx - 1].d.getMonth())
  .slice(1);
---

<figure class="card p-5">
  <figcaption class="mb-3 flex items-baseline justify-between text-sm">
    <span><strong class="text-slate-900 dark:text-white">{total.toLocaleString()}</strong> contributions in the last year</span>
    <span class="hidden items-center gap-1 text-xs text-slate-500 sm:flex">
      Less {fills.map((f) => <svg class="size-2.5" viewBox="0 0 10 10"><rect width="10" height="10" rx="2" class={f} /></svg>)} More
    </span>
  </figcaption>
  <div class="overflow-x-auto">
    <svg viewBox={`0 -14 ${width} ${height + 14}`} class="min-w-[640px]" role="img" aria-label={`${total} GitHub contributions in the last year`}>
      {months.map(({ i, d }) => (
        <text x={i * (cell + gap)} y="-4" class="fill-slate-500 text-[9px]">
          {d.toLocaleString('en-GB', { month: 'short' })}
        </text>
      ))}
      {weeks.map((w, x) =>
        w.map((day) => (
          <rect
            x={x * (cell + gap)}
            y={new Date(day.date).getUTCDay() * (cell + gap)}
            width={cell}
            height={cell}
            rx="2"
            class={fills[day.level]}
          >
            <title>{`${day.count} on ${day.date}`}</title>
          </rect>
        )),
      )}
    </svg>
  </div>
</figure>
